# Copy this file to .env.local and fill in values from your Supabase project
# settings (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never import from a Client
# Component. Used only for admin/service operations (e.g. Phase 7 moderation).
SUPABASE_SERVICE_ROLE_KEY=
